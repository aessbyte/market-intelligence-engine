{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aessbyte/market-intelligence-engine/result.schema.json",
  "title": "Market Intelligence Engine result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine_version",
    "symbol",
    "as_of_ms",
    "status",
    "provenance",
    "configuration",
    "timeframes",
    "regime",
    "evidence",
    "limitations",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "engine_version": {
      "type": "string"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9]{5,30}$"
    },
    "as_of_ms": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "ok",
        "degraded"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "market",
        "simulated",
        "snapshot_sha256",
        "server_time_ms",
        "requested_bars",
        "endpoint",
        "source_claim_verified"
      ],
      "properties": {
        "source": {
          "enum": [
            "binance_public",
            "simulated"
          ]
        },
        "market": {
          "const": "binance_spot"
        },
        "simulated": {
          "type": "boolean"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "server_time_ms": {
          "type": "integer"
        },
        "requested_bars": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000
        },
        "endpoint": {
          "type": "string"
        },
        "source_claim_verified": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "required": [
        "rules",
        "minimum_history",
        "aggregate_rule"
      ]
    },
    "timeframes": {
      "type": "object",
      "required": [
        "H1",
        "H4",
        "D1"
      ],
      "additionalProperties": false,
      "properties": {
        "H1": {
          "$ref": "#/$defs/frame"
        },
        "H4": {
          "$ref": "#/$defs/frame"
        },
        "D1": {
          "$ref": "#/$defs/frame"
        }
      }
    },
    "regime": {
      "$ref": "#/$defs/regime"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scenarios": {
      "$ref": "#/$defs/scenarios"
    }
  },
  "$defs": {
    "regime": {
      "enum": [
        "alta",
        "baixa",
        "lateralizacao",
        "indeterminado"
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "condition",
          "invalidation",
          "probability",
          "price_target"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "invalidation": {
            "type": "string"
          },
          "probability": {
            "type": "null"
          },
          "price_target": {
            "type": "null"
          }
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval",
        "quality",
        "indicators",
        "regime",
        "evidence",
        "scenarios"
      ],
      "properties": {
        "interval": {
          "enum": [
            "1h",
            "4h",
            "1d"
          ]
        },
        "quality": {
          "type": "object",
          "required": [
            "valid",
            "errors"
          ],
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "indicators": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "close",
                "sma20",
                "ema20",
                "ema50",
                "ema20_slope5_atr",
                "ema_gap_atr",
                "rsi14",
                "atr14",
                "atr_percent",
                "realized_volatility20",
                "bollinger_lower20",
                "bollinger_upper20",
                "volume_ratio20",
                "obv",
                "efficiency20"
              ],
              "properties": {
                "volume_ratio20": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "additionalProperties": {
                "type": "number"
              }
            }
          ]
        },
        "regime": {
          "$ref": "#/$defs/regime"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "scenarios": {
          "$ref": "#/$defs/scenarios"
        }
      }
    }
  }
}
